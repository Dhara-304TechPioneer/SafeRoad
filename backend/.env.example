# SafeRoad Backend Environment Configuration

# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/saferoad?schema=public"

# Secret key for JWT generation and verification
# IMPORTANT: Generate a strong secret key in production.
# Example command: openssl rand -base64 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_YOUR_SECURE_RANDOM_SECRET_KEY_HERE"

# Application Server Port (Default: 8000)
PORT=8000

# AI Microservice URL for computer vision detection
AI_SERVICE_URL="http://localhost:8001"

# Allowed CORS origins (comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Node environment (development | production | test)
NODE_ENV="development"
